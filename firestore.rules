rules_version = '2';

// Regras do Cloud Firestore do projeto estoquemov.
// Troque ROBO_UID pelo UID do usuário robô (Authentication > Users) antes de publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehRobo() {
      return request.auth != null && request.auth.uid == 'ROBO_UID';
    }
    // usuários do app entram com login anônimo do Firebase Auth
    function ehUsuarioApp() {
      return request.auth != null && !ehRobo();
    }
    function loteValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['geradoEm', 'periodo', 'pedidos'])
        && d.keys().hasOnly(['formato', 'versao', 'geradoEm', 'periodo', 'pedidos'])
        && (d.geradoEm is timestamp || d.geradoEm is string)
        && d.pedidos is list
        && d.pedidos.size() > 0
        && (!('formato' in d) || d.formato == 'PORTOEX-PEDIDOS')
        && (!('versao' in d) || d.versao == 1);
    }

    // robô: só cria (sem ler, alterar ou excluir); app: só lê
    match /lotesPedidos/{lote} {
      allow create: if ehRobo() && loteValido();
      allow get, list: if ehUsuarioApp();
      allow update, delete: if false;
    }

    // qualquer outro caminho fica fechado
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
